{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    {
      "src": "^/(menu|best|register|login|logout|profile|contact|orderDetails|api)(.*)",
      "dest": "/index.js"
    },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}